#!/bin/sh
# opkg postinst — runs on the router after the files are unpacked.
# Same runtime setup install.sh performs: cron lines, cron service,
# sysupgrade.conf registration. Idempotent.
[ -n "$IPKG_INSTROOT" ] && exit 0

BIN=/usr/bin/nordvpn-rotate.sh
CONF=/etc/nordvpn-rotate.conf
DASH=/www/cgi-bin/rotator
CRONTAB=/etc/crontabs/root
# nightly at 04:15 on purpose — a :00/:30 time would race the */30 run line
# for the lock and the nightly rotation would silently lose
NIGHTLY_LINE="15 4 * * * $BIN nightly"

mkdir -p "$(dirname "$CRONTAB")"
touch "$CRONTAB"
grep -qF "$BIN run" "$CRONTAB" || echo "*/30 * * * * $BIN run" >> "$CRONTAB"
# migrate any older nightly line (e.g. the 04:30 one)
if grep -qF "$BIN nightly" "$CRONTAB" && ! grep -qxF "$NIGHTLY_LINE" "$CRONTAB"; then
    grep -vF "$BIN nightly" "$CRONTAB" > "$CRONTAB.tmp"
    mv "$CRONTAB.tmp" "$CRONTAB"
fi
grep -qxF "$NIGHTLY_LINE" "$CRONTAB" || echo "$NIGHTLY_LINE" >> "$CRONTAB"
/etc/init.d/cron enable 2>/dev/null
/etc/init.d/cron restart 2>/dev/null

touch /etc/sysupgrade.conf
for p in "$BIN" "$CONF" "$CRONTAB" "$DASH"; do
    grep -qxF "$p" /etc/sysupgrade.conf || echo "$p" >> /etc/sysupgrade.conf
done

echo "nordvpn-rotate installed (live mode — dashboard: http://192.168.8.1/cgi-bin/rotator)"
echo "next: $BIN check   (read-only verification)"
exit 0
